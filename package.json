{
  "name": "prism",
  "version": "1.0.0",
  "private": true,
  "description": "PRISM — premium multilingual (FA/EN/DE/TR) website + admin dashboard for an AI & data intelligence company. Vite + React + TypeScript front, Express + node:sqlite back.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/server.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "cross-env NODE_ENV=production node dist-server/server.js",
    "init-db": "tsx server/scripts/init-db.ts",
    "seed": "tsx server/scripts/seed.ts",
    "create-admin": "tsx server/scripts/create-admin.ts",
    "bootstrap": "npm run init-db && npm run seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@react-three/drei": "9.117.3",
    "@react-three/fiber": "8.17.10",
    "argon2": "0.45.1",
    "cookie": "1.0.2",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "multer": "2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "three": "0.160.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/vazirmatn": "^5.1.0",
    "@playwright/test": "1.48.2",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.6.1",
    "@types/cookie": "^1.0.0",
    "@types/express": "4.17.21",
    "@types/multer": "2.0.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "cross-env": "^7.0.3",
    "jsdom": "25.0.1",
    "playwright": "1.48.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.9"
  }
}
